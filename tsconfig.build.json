{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "src/components/organisms/AgentHarnessDiagram/**",
    "src/components/organisms/CausalShiftDiagram/**",
    "src/components/organisms/FeedbackLoopsDiagram/**",
    "src/components/organisms/KnowledgeTreeMap/**",
    "src/components/organisms/MetricSparkBoard/**",
    "src/components/organisms/StepLoopFlow/**"
  ]
}
